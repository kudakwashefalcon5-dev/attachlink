DirectoryIndex index.php
Options -Indexes
<IfModule mod_headers.c>
    Header onsuccess unset Content-Security-Policy
    Header onsuccess unset Permissions-Policy
    Header onsuccess unset Cache-Control
    Header onsuccess unset X-Content-Type-Options
    Header always unset Cache-Control
    Header always unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "(?i)\.(css|js|mjs|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header always set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    <FilesMatch "(?i)\.(html?|php)$">
        Header always set Cache-Control "no-store"
    </FilesMatch>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    Header always set Content-Security-Policy "expr=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: %{reqenv:ATTACHLINK_MAP_TILE_ORIGIN}; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" "expr=reqenv('ATTACHLINK_MAP_TILE_ORIGIN') =~ m#^https://[a-zA-Z0-9.-]+(?::[0-9]+)?$#"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' && reqenv('ATTACHLINK_ENV') == 'production'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.git(?:/|$)" - [F,L,NC]
    RewriteRule "^(database|docs|vendor|tests|scripts|dist|test-results|node_modules|\.git)(/|$)" - [F,L,NC]
    RewriteRule "^backend/(?:jobs|lib)(/|$)" - [F,L,NC]
    RewriteRule "^dev-router\.php$" - [F,L,NC]
</IfModule>

<FilesMatch "(?i)^(composer\..*|package.*\.json|.*\.md)$">
    Require all denied
</FilesMatch>
