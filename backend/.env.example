# Local XAMPP defaults. Copy to backend/.env and change values as needed.
# Apache and CLI read this file. Environment variables take precedence.
ATTACHLINK_ENV=development
# Production only. Set a secret 32-byte value encoded as 64 hexadecimal characters.
# ATTACHLINK_ADMIN_TOTP_KEY=
ATTACHLINK_DB_HOST=127.0.0.1
ATTACHLINK_DB_PORT=3306
ATTACHLINK_DB_NAME=attachlink_db
ATTACHLINK_DB_USER=root
ATTACHLINK_DB_PASS=
# Optional on loopback when installed at /attachlink.
# ATTACHLINK_BASE_URL=http://localhost/attachlink
# Defaults to backend/storage/documents when omitted.
# ATTACHLINK_DOCUMENT_STORAGE=C:/private/attachlink/documents
ATTACHLINK_TRUSTED_PROXIES=
ATTACHLINK_MAIL_TRANSPORT=log
# When omitted, the local log is written under the PHP temporary directory.
# ATTACHLINK_MAIL_LOG=C:/private/attachlink/mail.jsonl

# For an SMTP deployment, set ATTACHLINK_ENV=production, configure an HTTPS
# base URL and a dedicated database user/password, and select smtp above.
# ATTACHLINK_SMTP_HOST=
# ATTACHLINK_SMTP_PORT=
# ATTACHLINK_SMTP_TLS=starttls
# ATTACHLINK_SMTP_EHLO=
# ATTACHLINK_SMTP_FROM=
# ATTACHLINK_SMTP_AUTH=LOGIN
# ATTACHLINK_SMTP_USERNAME=
# ATTACHLINK_SMTP_PASSWORD=

# Scheduled backup job
# ATTACHLINK_BACKUP_DIR=C:/private/attachlink/backups
# ATTACHLINK_BACKUP_DAYS=30
# ATTACHLINK_MYSQLDUMP=C:/xampp/mysql/bin/mysqldump.exe

# The backup server only receives the age public recipient. Keep its identity off-server.
# ATTACHLINK_AGE=C:/tools/age.exe
# ATTACHLINK_BACKUP_RECIPIENT=age1...
