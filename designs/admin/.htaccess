<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} ^(.*/designs)/admin/login\.html$
RewriteRule ^login\.html$ %1/admin/sign-in.html [R=302,L]
RewriteRule ^(attachees\-directory|companies|dashboard|messages|placements\-registry|system\-settings|verification\-queue)\.html$ auth-gate.php?page=$1 [QSA,L]
</IfModule>
<IfModule !mod_rewrite.c>
<FilesMatch "\.html$">
Require all denied
</FilesMatch>
</IfModule>
