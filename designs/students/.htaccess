<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(account|attachment\-details|career\-tools|cv\-builder|dashboard|data\-settings|interview\-planner|messages|my\-applications|notifications|profile|saved\-openings)\.html$ auth-gate.php?page=$1 [QSA,L]
</IfModule>
<IfModule !mod_rewrite.c>
<FilesMatch "\.html$">
Require all denied
</FilesMatch>
</IfModule>
<FilesMatch "^dashboard(-backup|1)\.html$">
Require all denied
</FilesMatch>
